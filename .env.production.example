# ─────────────────────────────────────────────────────────────
# Handly — PRODUCTION environment template (Batch 4).
# Copy to .env.production, fill in every "CHANGE ME", and load it via a
# secrets manager (SOPS/Doppler/your platform's secret store) — never commit
# the filled-in file. See docs/runbooks/deployment.md for the full checklist.
# ─────────────────────────────────────────────────────────────

# --- Database — real managed Postgres (with PostGIS enabled), not the dev container ---
# connection_limit is unset in dev (Prisma defaults to num_cpus*2+1 per
# instance, fine for one local process). In production, set it explicitly:
# (connection_limit × number of running API instances) must stay under your
# Postgres's max_connections, or a second/third instance can starve the
# first's pool. 10 is a reasonable starting cap for a single instance at
# launch — raise it only alongside real max_connections headroom, not blindly.
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/handly?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"

# --- Redis — real managed Redis, ideally with AOF persistence + auth ---
REDIS_URL="rediss://:CHANGE_ME@CHANGE_ME:6379"

# --- API ---
API_PORT=3001
NODE_ENV=production
# Real public origin of the web app (https, real domain) — CORS + refresh-cookie depend on this being exact.
WEB_ORIGIN="https://CHANGE_ME.example"

# --- Trusted proxy hop (SECURITY-CRITICAL — do not leave at the default
# without verifying it matches your real topology; see the long comment on
# TRUSTED_PROXY in infra/config/env.ts). If nginx/your LB reaches this
# container over a Docker bridge network (not true loopback), this MUST be
# that bridge's real subnet (check `docker network inspect`), or req.ip
# becomes spoofable via a forged X-Forwarded-For header — which drives both
# the per-IP rate limiter's key and Session.ip.
TRUSTED_PROXY="CHANGE_ME"

# --- Error monitoring — real DSN turns this on; loadEnv() has no separate
# "is this really production" toggle for Sentry itself, so this is the only
# switch that matters.
SENTRY_DSN="CHANGE_ME"
NEXT_PUBLIC_SENTRY_DSN="CHANGE_ME"

# --- Auth / JWT — MUST be freshly generated, MUST be >=32 chars, MUST NOT
# match any value in .env.example (loadEnv() refuses to boot in production
# against the known dev-placeholder values or anything under 32 chars — see
# infra/config/env.ts). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
# 32-byte column-encryption key for PINFL/MyID payloads. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="CHANGE_ME"

# --- OTP (defaults are reasonable for production as-is) ---
OTP_TTL_SECONDS=180
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_DAILY_CAP_PER_PHONE=10

# --- Login brute-force protection (defaults are reasonable for production as-is) ---
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# --- Global per-IP rate limit (defaults are reasonable for production as-is;
# tune down if behind a shared corporate NAT causes false positives, or up if
# legitimate traffic patterns trip it — watch 429 rates after launch) ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- SMS provider — must be "eskiz" (or a real provider) in production; "mock" only prints to logs ---
SMS_PROVIDER=eskiz
ESKIZ_EMAIL="CHANGE_ME"
ESKIZ_PASSWORD="CHANGE_ME"
ESKIZ_BASE_URL="https://notify.eskiz.uz/api"
ESKIZ_FROM="CHANGE_ME"

# --- Tax provider — stays "mock" until a real Soliq integration is contracted; see CLAUDE.md ---
TAX_PROVIDER=mock
TAX_WITHHOLDING_RATE=0.01

# --- AI diagnosis — "mock" still works with zero cost/risk if you'd rather
# not enable real AI diagnosis at launch; set "claude" + a real key to turn it on ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY="CHANGE_ME"
AI_MODEL="claude-opus-4-8"
AI_TIMEOUT_MS=12000

# --- Order media uploads — LocalDiskStorage needs a persistent volume
# mounted at this path (see docker-compose.prod.yml's handly_uploads volume);
# a real deployment should migrate to an S3 StorageProvider before scaling
# past one API instance (LocalDiskStorage is not shared across replicas).
UPLOAD_DIR="./uploads"
UPLOAD_MAX_PHOTO_MB=10
UPLOAD_MAX_VIDEO_MB=50
ORDER_MAX_MEDIA=5

# --- Push notifications — "mock" only logs; set "fcm" + real service-account
# credentials once push-token registration exists on the client (see CLAUDE.md
# "Deliberately scoped down" — M3's FcmPushProvider is real but unexercised).
PUSH_PROVIDER=mock
FCM_PROJECT_ID="CHANGE_ME"
FCM_CLIENT_EMAIL="CHANGE_ME"
FCM_PRIVATE_KEY="CHANGE_ME"

# --- Dispatch (defaults are reasonable for production as-is) ---
DISPATCH_TOP_N=5
DISPATCH_RADIUS_EXPANSION_FACTOR=2
DISPATCH_OFFER_TTL_SCHEDULED_SECONDS=600
DISPATCH_OFFER_TTL_PRIORITY_SECONDS=120
DISPATCH_OFFER_TTL_EMERGENCY_SECONDS=60

# --- Payments — stays "mock" until real Click/Payme/Uzum merchant credentials exist ---
PAYMENT_PROVIDER=mock

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="https://CHANGE_ME.example/api/v1"
NEXT_PUBLIC_APP_NAME="Handly"
