// Handly — Prisma schema (Milestone 1: auth, sessions, profiles, catalog).
// Later milestones extend this (orders, dispatch, payments, wallets, trust, …).
// Geo columns use lat/lng decimals for now; PostGIS geography + GIST indexes
// are introduced in Milestone 3 when dispatch needs radius queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────
enum Role {
  CUSTOMER
  MASTER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum Locale {
  uz
  ru
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationProvider {
  MYID
  MANUAL
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
}

enum MasterMediaKind {
  CERTIFICATION
  PORTFOLIO
}

enum AvailabilityKind {
  BUSY
  BOOKED
}

enum AvailabilitySource {
  MANUAL
  ORDER
  DIDOX
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum ServiceTier {
  SCHEDULED
  PRIORITY
  EMERGENCY
}

enum Complexity {
  SIMPLE
  MEDIUM
  COMPLEX
  CRITICAL
}

// Full lifecycle per ARCHITECTURE §orders; M2 implements DRAFT→PRICED→SEARCHING
// (+ customer cancel). Later milestones use the remaining states.
enum OrderStatus {
  DRAFT
  PRICED
  SEARCHING
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_MASTER
  EXPIRED
  DISPUTED
}

enum OrderMediaKind {
  PHOTO
  VIDEO
}

// Who attached the file — the customer's initial problem photos/videos vs.
// the master's job-completion evidence (M4). Same table/model either way;
// this discriminator is all that's needed to tell them apart for display.
enum OrderMediaUploader {
  CUSTOMER
  MASTER
}

// ─────────────────────────── Dispatch (M3) ───────────────────────────
enum DispatchStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum NotificationType {
  OFFER_RECEIVED
  OFFER_EXPIRED
  ORDER_ASSIGNED
  ORDER_SEARCH_FAILED
  // M4 — job execution
  ORDER_COMPLETED
  ORDER_CLOSED
  // M5 — payments
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  // Batch 2 — trust, safety & growth
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  GUARANTEE_CLAIM_DECIDED
  PENALTY_ISSUED
  REFERRAL_REWARDED
  ORDER_CANCELLED_BY_MASTER
  // Beta Blocker Sprint — one type covers both refund and no-refund
  // resolution outcomes, distinguished by the notification body text
  // (same shape as GUARANTEE_CLAIM_DECIDED covering approve/reject).
  PAYMENT_RESOLVED
}

// ─────────────────────────── Identity ───────────────────────────
model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(PENDING)
  referralCode String     @unique
  locale       Locale     @default(uz)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customerProfile CustomerProfile?
  masterProfile   MasterProfile?
  sessions        Session[]
  devices         Device[]
  addresses       Address[]
  orders          Order[]
  notifications   Notification[]
  payments        Payment[]
  reviewsWritten  Review[]
  guaranteeClaims GuaranteeClaim[]
  cashbackRecords CashbackRecord[]
  // Batch 2 referrals: this user as the referrer (many) vs. as the referee (at most one).
  referralsMade   Referral[]       @relation("ReferrerOf")
  referredBy      Referral?        @relation("ReferredBy")

  @@map("users")
}

model CustomerProfile {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model MasterProfile {
  userId             String             @id @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String?
  avatarUrl          String?
  experienceYears    Int                @default(0)
  bio                String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  trustTier          Int                @default(0)
  ratingAvg          Decimal            @default(0) @db.Decimal(3, 2)
  jobsDone           Int                @default(0)
  // PINFL (JShShIR) stored as AES-256-GCM ciphertext, never plaintext.
  pinflEncrypted     String?
  isSelfEmployed     Boolean            @default(false)
  // Real-time presence (M3) — the master's own "I'm working now" declaration;
  // doubles as their working-hours signal (see AvailabilitySlot for day-level
  // busy/booked blocking, which combines with this at dispatch-eligibility time).
  isOnline           Boolean            @default(false)
  onlineSince        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  skills        MasterSkill[]
  media         MasterMedia[]
  serviceAreas  ServiceArea[]
  availability  AvailabilitySlot[]
  verifications Verification[]
  dispatches    OrderDispatch[]
  assignedOrders Order[]
  reviews         Review[]
  penaltyRecords  PenaltyRecord[]
  subscription    MasterSubscription?

  @@index([isOnline])
  @@map("master_profiles")
}

// ─────────────────────────── Catalog ───────────────────────────
model ServiceCategory {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  nameUz           String
  nameRu           String
  basePriceMin     Int
  basePriceMax     Int
  warrantyEligible Boolean       @default(true)
  active           Boolean       @default(true)
  iconKey          String?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())

  masterSkills MasterSkill[]
  orders       Order[]

  @@map("service_categories")
}

model MasterSkill {
  id         String          @id @default(uuid()) @db.Uuid
  masterId   String          @db.Uuid
  master     MasterProfile   @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([masterId, categoryId])
  @@index([categoryId])
  @@map("master_skills")
}

model MasterMedia {
  id            String          @id @default(uuid()) @db.Uuid
  masterId      String          @db.Uuid
  master        MasterProfile   @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  kind          MasterMediaKind
  objectKey     String
  mime          String?
  caption       String?
  adminApproved Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([masterId])
  @@map("master_media")
}

model ServiceArea {
  id        String        @id @default(uuid()) @db.Uuid
  masterId  String        @db.Uuid
  master    MasterProfile @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  label     String
  centerLat Decimal       @db.Decimal(9, 6)
  centerLng Decimal       @db.Decimal(9, 6)
  radiusM   Int
  // Generated column (Postgres GENERATED ALWAYS AS ... STORED, GIST-indexed) —
  // kept in sync by Postgres itself from centerLat/centerLng. Prisma never
  // writes it; only read via raw SQL in the dispatch eligibility query.
  centerPoint Unsupported("geography(Point, 4326)")?
  createdAt DateTime      @default(now())

  @@index([masterId])
  @@map("service_areas")
}

model AvailabilitySlot {
  id        String             @id @default(uuid()) @db.Uuid
  masterId  String             @db.Uuid
  master    MasterProfile      @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  day       DateTime           @db.Date
  kind      AvailabilityKind
  source    AvailabilitySource @default(MANUAL)
  createdAt DateTime           @default(now())

  @@unique([masterId, day, kind])
  @@map("availability_slots")
}

model Verification {
  id         String               @id @default(uuid()) @db.Uuid
  masterId   String               @db.Uuid
  master     MasterProfile        @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  provider   VerificationProvider @default(MANUAL)
  status     VerificationStatus   @default(PENDING)
  payload    Json?
  note       String?
  decidedBy  String?              @db.Uuid
  decidedAt  DateTime?
  createdAt  DateTime             @default(now())

  @@index([masterId])
  @@index([status])
  @@map("verifications")
}

// ─────────────────────────── Addresses ───────────────────────────
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  addressText String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────── Auth plumbing ───────────────────────────
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken String         @unique
  platform  DevicePlatform @default(WEB)
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("devices")
}

// ─────────────────────────── Orders (M2) ───────────────────────────
model Order {
  id          String          @id @default(uuid()) @db.Uuid
  orderNo     Int             @unique @default(autoincrement())
  customerId  String          @db.Uuid
  customer    User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categoryId  String?         @db.Uuid
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String
  status      OrderStatus     @default(DRAFT)
  serviceTier ServiceTier     @default(SCHEDULED)
  scheduledAt DateTime?
  // Address snapshot (deliberate denormalization — order keeps the address as it was).
  addressText String?
  latitude    Decimal?        @db.Decimal(9, 6)
  longitude   Decimal?        @db.Decimal(9, 6)
  // Generated column mirroring latitude/longitude (see ServiceArea.centerPoint) —
  // the actual PostGIS input for dispatch's distance/radius queries (M3).
  location    Unsupported("geography(Point, 4326)")?
  // Set once a dispatch offer is accepted (M3). Nullable — most of an order's
  // life (DRAFT..SEARCHING) it has no master yet.
  masterId    String?         @db.Uuid
  master      MasterProfile?  @relation(fields: [masterId], references: [userId], onDelete: SetNull)
  // AI-assisted quote
  complexity  Complexity?
  aiDiagnosis Json?
  priceMin    Int?
  priceMax    Int?
  platformFee Int             @default(0)
  // Set by the master at job completion (M4) — the actual agreed price,
  // within [priceMin, priceMax]. This is what a Payment (M5) charges.
  finalAmount Int?
  // Lifecycle timestamps
  consentAcceptedAt DateTime?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  media         OrderMedia[]
  statusHistory OrderStatusHistory[]
  dispatches    OrderDispatch[]
  payments      Payment[]
  review          Review?
  guaranteeClaim  GuaranteeClaim?
  penaltyRecords  PenaltyRecord[]

  @@index([customerId, createdAt])
  @@index([status])
  // Every masterId lookup (getCurrentJob, dispatch's "already has an active
  // job" check) also filters status='ASSIGNED' — composite replaces the old
  // masterId-only index since it covers both shapes (leftmost-prefix).
  @@index([masterId, status])
  // Batch 3 admin order list is unscoped (no customerId/masterId filter),
  // so it needs its own sort index rather than relying on the composite ones above.
  @@index([createdAt])
  @@map("orders")
}

model OrderMedia {
  id             String             @id @default(uuid()) @db.Uuid
  orderId        String             @db.Uuid
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           OrderMediaKind
  uploadedByRole OrderMediaUploader @default(CUSTOMER)
  objectKey      String
  mime           String
  sizeBytes      Int
  createdAt      DateTime           @default(now())

  @@index([orderId])
  @@map("order_media")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─────────────────────────── Payments (M5) ───────────────────────────
// One customer-facing payment attempt per row. A retried/failed attempt
// creates a new row rather than mutating the failed one — the audit trail
// (and any provider webhook replay) stays intact. Only one SUCCEEDED
// payment may ever exist per order; enforced in PaymentsService via a
// FOR UPDATE transaction on the order row (see acceptOffer/consumeSession
// for the identical pattern), not a DB constraint, since "at most one
// success" isn't expressible as a plain unique index here.
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  // Beta Blocker Sprint — manual admin resolution foundation, no real
  // provider reversal call yet (see PaymentsService.resolve).
  REFUNDED
}

// Which rail the customer picked. Only MOCK is wired to a real provider
// today (PAYMENT_PROVIDER env) — CLICK/PAYME/UZUM are modeled so the
// selection UI and data are provider-aware ahead of real credentials.
enum PaymentMethod {
  CLICK
  PAYME
  UZUM
  MOCK
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @db.Uuid
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String        @db.Uuid
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  // Integer so'm throughout — never floats (project convention).
  amount        Int
  platformFee   Int
  taxRate       Decimal   @db.Decimal(5, 4)
  taxAmount     Int
  masterNetAmount Int
  taxWithholdingRef String?
  // External provider's own transaction id — unique so a replayed webhook
  // for the same transaction is a no-op, not a double-settle.
  providerRef   String?   @unique
  failureReason String?
  // Beta Blocker Sprint — manual resolution foundation (admin-triggered,
  // no real payment-provider reversal call). resolutionNote/resolvedAt are
  // set whenever an admin closes the loop on a payment issue, whether or
  // not it results in a REFUNDED status change.
  resolutionNote    String?
  resolvedByAdminId String?   @db.Uuid
  resolvedAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  succeededAt   DateTime?
  failedAt      DateTime?

  @@index([orderId])
  @@index([customerId, createdAt])
  @@map("payments")
}

// ─────────────────────────── Dispatch (M3) ───────────────────────────
// One row per master offered a given order, in cascade order. Sequential —
// only one row is ever OFFERED at a time per order; ACCEPTED is terminal for
// the order, the rest are WITHDRAWN. See apps/api/src/modules/dispatch.
model OrderDispatch {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  masterId      String         @db.Uuid
  master        MasterProfile  @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  rankInCascade Int
  distanceM     Int
  score         Decimal        @db.Decimal(6, 2)
  status        DispatchStatus @default(OFFERED)
  // Default rule (ARCHITECTURE §9.2.6): counted on ACCEPTED, not on offer —
  // Free masters aren't punished for declining. Unread until M5's lead-quota
  // system exists; correctly computed now so that system needs no backfill.
  countedAsLead Boolean        @default(false)
  offeredAt     DateTime       @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@unique([orderId, masterId])
  @@index([orderId])
  @@index([masterId, status])
  @@map("order_dispatches")
}

// ─────────────────────────── Notifications (M3) ───────────────────────────
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  // Free-form payload (e.g. {orderId}) — kept generic rather than a hard FK
  // since notification kinds will grow across future milestones.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────── Reviews (Batch 2) ───────────────────────────
// One review per order (customer → master), only for CLOSED orders. Real
// data source for MasterProfile.ratingAvg (recomputed on each new review),
// the trust score's rating factor, penalty's "poor quality"/"complaint"
// triggers, and master analytics' rating trend — replaces what was, until
// now, a static/seed-only ratingAvg value.
model Review {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @db.Uuid
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String        @db.Uuid
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  masterId   String        @db.Uuid
  master     MasterProfile @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())

  @@index([masterId, createdAt])
  @@map("reviews")
}

// ─────────────────────────── Penalty engine (Batch 2) ───────────────────────────
enum PenaltyEventType {
  CANCELLATION
  NO_SHOW
  LATE_RESPONSE
  POOR_QUALITY
  CUSTOMER_COMPLAINT
}

enum PenaltySeverity {
  MINOR
  MODERATE
  SEVERE
}

// One row per penalty-worthy event. Points/severity come from a single
// PENALTY_RULES config table (apps/api/src/modules/penalties/penalty-rules.ts),
// never hardcoded at each call site. Never auto-bans — only auto-recomputes
// the master's trust tier (see TrustService), same "assists, never gates"
// spirit as the rest of this codebase's automation.
model PenaltyRecord {
  id        String            @id @default(uuid()) @db.Uuid
  masterId  String            @db.Uuid
  master    MasterProfile     @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  eventType PenaltyEventType
  severity  PenaltySeverity
  points    Int
  orderId   String?           @db.Uuid
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime          @default(now())

  @@index([masterId, createdAt])
  @@map("penalty_records")
}

// ─────────────────────────── Handly Guarantee (Batch 2) ───────────────────────────
enum GuaranteeClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// One claim per order. No automated adjudication — decidedBy/decidedAt/note
// mirrors the existing Verification model's admin-decision shape so a future
// admin dashboard (Batch 3) can slot in without a new pattern.
model GuaranteeClaim {
  id             String               @id @default(uuid()) @db.Uuid
  orderId        String               @unique @db.Uuid
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId     String               @db.Uuid
  customer       User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason         String
  status         GuaranteeClaimStatus @default(OPEN)
  decidedBy      String?              @db.Uuid
  decidedAt      DateTime?
  resolutionNote String?
  createdAt      DateTime             @default(now())

  @@index([customerId, createdAt])
  @@index([status])
  @@map("guarantee_claims")
}

// ─────────────────────────── Referrals & cashback (Batch 2) ───────────────────────────
// User.referralCode already exists (M1) — this models the actual referral
// RELATIONSHIP once someone signs up using that code, plus its lifecycle:
// PENDING (registered, not yet verified) → ACTIVE (account verified) →
// REWARDED (referee's first successful payment granted the referrer cashback).
enum ReferralStatus {
  PENDING
  ACTIVE
  REWARDED
}

model Referral {
  id         String         @id @default(uuid()) @db.Uuid
  referrerId String         @db.Uuid
  referrer   User           @relation("ReferrerOf", fields: [referrerId], references: [id], onDelete: Cascade)
  // A user can only ever be referred once.
  refereeId  String         @unique @db.Uuid
  referee    User           @relation("ReferredBy", fields: [refereeId], references: [id], onDelete: Cascade)
  status     ReferralStatus @default(PENDING)
  rewardedAt DateTime?
  createdAt  DateTime       @default(now())

  cashbackRecords CashbackRecord[]

  @@index([referrerId])
  @@map("referrals")
}

enum CashbackSourceType {
  REFERRAL_REWARD
  PROMOTION
}

// A ledger-style record, not a wallet — no withdrawal/redemption flow exists
// yet (explicitly out of scope this batch). REDEEMED is modeled for when
// that later system lands; nothing sets it today.
enum CashbackStatus {
  ELIGIBLE
  REDEEMED
}

model CashbackRecord {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  sourceType CashbackSourceType
  status     CashbackStatus     @default(ELIGIBLE)
  referralId String?            @db.Uuid
  referral   Referral?          @relation(fields: [referralId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("cashback_records")
}

// ─────────────────────────── Master subscriptions (Batch 2) ───────────────────────────
// Free tier is the implicit default (no row) — a row only ever gets created
// on the first upgrade action. Not connected to any payment provider yet
// (explicitly out of scope this batch); when real billing lands, it reuses
// the existing Payment/PaymentProvider architecture rather than a parallel one.
enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

model MasterSubscription {
  masterId         String              @id @db.Uuid
  master           MasterProfile       @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  plan             SubscriptionPlan    @default(FREE)
  status           SubscriptionStatus  @default(ACTIVE)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("master_subscriptions")
}

// ─────────────────────────── Admin operations (Batch 3) ───────────────────────────
// Append-only. Written by every admin mutation (suspend/restore, verification/
// guarantee decide, feature-flag change) — actor + action + before/after, per
// ARCHITECTURE §Admin surface's "every admin mutation in append-only audit_log
// with actor + before/after." No FK to User: an admin's audit trail must
// survive that admin account being deleted/anonymized later.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Configuration/feature-flag foundation only (per Batch 3 scope) — nothing
// reads these to gate behavior yet. Flat key/value rather than the full
// versioned-JSONB rules engine in ARCHITECTURE §9.5, which is a later,
// larger system once a real flag actually needs runtime consumption.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
