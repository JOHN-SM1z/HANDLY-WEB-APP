// Handly — Prisma schema (Milestone 1: auth, sessions, profiles, catalog).
// Later milestones extend this (orders, dispatch, payments, wallets, trust, …).
// Geo columns use lat/lng decimals for now; PostGIS geography + GIST indexes
// are introduced in Milestone 3 when dispatch needs radius queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────
enum Role {
  CUSTOMER
  MASTER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum Locale {
  uz
  ru
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationProvider {
  MYID
  MANUAL
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
}

enum MasterMediaKind {
  CERTIFICATION
  PORTFOLIO
}

enum AvailabilityKind {
  BUSY
  BOOKED
}

enum AvailabilitySource {
  MANUAL
  ORDER
  DIDOX
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum ServiceTier {
  SCHEDULED
  PRIORITY
  EMERGENCY
}

enum Complexity {
  SIMPLE
  MEDIUM
  COMPLEX
  CRITICAL
}

// Full lifecycle per ARCHITECTURE §orders; M2 implements DRAFT→PRICED→SEARCHING
// (+ customer cancel). Later milestones use the remaining states.
enum OrderStatus {
  DRAFT
  PRICED
  SEARCHING
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_MASTER
  EXPIRED
  DISPUTED
}

enum OrderMediaKind {
  PHOTO
  VIDEO
}

// ─────────────────────────── Dispatch (M3) ───────────────────────────
enum DispatchStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum NotificationType {
  OFFER_RECEIVED
  OFFER_EXPIRED
  ORDER_ASSIGNED
  ORDER_SEARCH_FAILED
}

// ─────────────────────────── Identity ───────────────────────────
model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(PENDING)
  referralCode String     @unique
  locale       Locale     @default(uz)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customerProfile CustomerProfile?
  masterProfile   MasterProfile?
  sessions        Session[]
  devices         Device[]
  addresses       Address[]
  orders          Order[]
  notifications   Notification[]

  @@map("users")
}

model CustomerProfile {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model MasterProfile {
  userId             String             @id @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String?
  experienceYears    Int                @default(0)
  bio                String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  trustTier          Int                @default(0)
  ratingAvg          Decimal            @default(0) @db.Decimal(3, 2)
  jobsDone           Int                @default(0)
  // PINFL (JShShIR) stored as AES-256-GCM ciphertext, never plaintext.
  pinflEncrypted     String?
  isSelfEmployed     Boolean            @default(false)
  // Real-time presence (M3) — the master's own "I'm working now" declaration;
  // doubles as their working-hours signal (see AvailabilitySlot for day-level
  // busy/booked blocking, which combines with this at dispatch-eligibility time).
  isOnline           Boolean            @default(false)
  onlineSince        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  skills        MasterSkill[]
  media         MasterMedia[]
  serviceAreas  ServiceArea[]
  availability  AvailabilitySlot[]
  verifications Verification[]
  dispatches    OrderDispatch[]
  assignedOrders Order[]

  @@index([isOnline])
  @@map("master_profiles")
}

// ─────────────────────────── Catalog ───────────────────────────
model ServiceCategory {
  id               String        @id @default(uuid()) @db.Uuid
  slug             String        @unique
  nameUz           String
  nameRu           String
  basePriceMin     Int
  basePriceMax     Int
  warrantyEligible Boolean       @default(true)
  active           Boolean       @default(true)
  iconKey          String?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())

  masterSkills MasterSkill[]
  orders       Order[]

  @@map("service_categories")
}

model MasterSkill {
  id         String          @id @default(uuid()) @db.Uuid
  masterId   String          @db.Uuid
  master     MasterProfile   @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  categoryId String          @db.Uuid
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([masterId, categoryId])
  @@index([categoryId])
  @@map("master_skills")
}

model MasterMedia {
  id            String          @id @default(uuid()) @db.Uuid
  masterId      String          @db.Uuid
  master        MasterProfile   @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  kind          MasterMediaKind
  objectKey     String
  caption       String?
  adminApproved Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@index([masterId])
  @@map("master_media")
}

model ServiceArea {
  id        String        @id @default(uuid()) @db.Uuid
  masterId  String        @db.Uuid
  master    MasterProfile @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  label     String
  centerLat Decimal       @db.Decimal(9, 6)
  centerLng Decimal       @db.Decimal(9, 6)
  radiusM   Int
  // Generated column (Postgres GENERATED ALWAYS AS ... STORED, GIST-indexed) —
  // kept in sync by Postgres itself from centerLat/centerLng. Prisma never
  // writes it; only read via raw SQL in the dispatch eligibility query.
  centerPoint Unsupported("geography(Point, 4326)")?
  createdAt DateTime      @default(now())

  @@index([masterId])
  @@map("service_areas")
}

model AvailabilitySlot {
  id        String             @id @default(uuid()) @db.Uuid
  masterId  String             @db.Uuid
  master    MasterProfile      @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  day       DateTime           @db.Date
  kind      AvailabilityKind
  source    AvailabilitySource @default(MANUAL)
  createdAt DateTime           @default(now())

  @@unique([masterId, day, kind])
  @@map("availability_slots")
}

model Verification {
  id         String               @id @default(uuid()) @db.Uuid
  masterId   String               @db.Uuid
  master     MasterProfile        @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  provider   VerificationProvider @default(MANUAL)
  status     VerificationStatus   @default(PENDING)
  payload    Json?
  note       String?
  decidedBy  String?              @db.Uuid
  decidedAt  DateTime?
  createdAt  DateTime             @default(now())

  @@index([masterId])
  @@index([status])
  @@map("verifications")
}

// ─────────────────────────── Addresses ───────────────────────────
model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  addressText String
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────── Auth plumbing ───────────────────────────
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

model Device {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken String         @unique
  platform  DevicePlatform @default(WEB)
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("devices")
}

// ─────────────────────────── Orders (M2) ───────────────────────────
model Order {
  id          String          @id @default(uuid()) @db.Uuid
  orderNo     Int             @unique @default(autoincrement())
  customerId  String          @db.Uuid
  customer    User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  categoryId  String?         @db.Uuid
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String
  status      OrderStatus     @default(DRAFT)
  serviceTier ServiceTier     @default(SCHEDULED)
  scheduledAt DateTime?
  // Address snapshot (deliberate denormalization — order keeps the address as it was).
  addressText String?
  latitude    Decimal?        @db.Decimal(9, 6)
  longitude   Decimal?        @db.Decimal(9, 6)
  // Generated column mirroring latitude/longitude (see ServiceArea.centerPoint) —
  // the actual PostGIS input for dispatch's distance/radius queries (M3).
  location    Unsupported("geography(Point, 4326)")?
  // Set once a dispatch offer is accepted (M3). Nullable — most of an order's
  // life (DRAFT..SEARCHING) it has no master yet.
  masterId    String?         @db.Uuid
  master      MasterProfile?  @relation(fields: [masterId], references: [userId], onDelete: SetNull)
  // AI-assisted quote
  complexity  Complexity?
  aiDiagnosis Json?
  priceMin    Int?
  priceMax    Int?
  platformFee Int             @default(0)
  // Lifecycle timestamps
  consentAcceptedAt DateTime?
  submittedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  media         OrderMedia[]
  statusHistory OrderStatusHistory[]
  dispatches    OrderDispatch[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([masterId])
  @@map("orders")
}

model OrderMedia {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      OrderMediaKind
  objectKey String
  mime      String
  sizeBytes Int
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@map("order_media")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─────────────────────────── Dispatch (M3) ───────────────────────────
// One row per master offered a given order, in cascade order. Sequential —
// only one row is ever OFFERED at a time per order; ACCEPTED is terminal for
// the order, the rest are WITHDRAWN. See apps/api/src/modules/dispatch.
model OrderDispatch {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  masterId      String         @db.Uuid
  master        MasterProfile  @relation(fields: [masterId], references: [userId], onDelete: Cascade)
  rankInCascade Int
  distanceM     Int
  score         Decimal        @db.Decimal(6, 2)
  status        DispatchStatus @default(OFFERED)
  // Default rule (ARCHITECTURE §9.2.6): counted on ACCEPTED, not on offer —
  // Free masters aren't punished for declining. Unread until M5's lead-quota
  // system exists; correctly computed now so that system needs no backfill.
  countedAsLead Boolean        @default(false)
  offeredAt     DateTime       @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())

  @@unique([orderId, masterId])
  @@index([orderId])
  @@index([masterId, status])
  @@map("order_dispatches")
}

// ─────────────────────────── Notifications (M3) ───────────────────────────
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  // Free-form payload (e.g. {orderId}) — kept generic rather than a hard FK
  // since notification kinds will grow across future milestones.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}
