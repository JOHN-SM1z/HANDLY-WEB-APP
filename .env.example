# ─────────────────────────────────────────────────────────────
# Handly — environment template. Copy to .env and fill in.
# NEVER commit a real .env. Prod secrets live in SOPS/Doppler.
# ─────────────────────────────────────────────────────────────

# --- Database (matches infra/docker/docker-compose.yml) ---
POSTGRES_USER=handly
POSTGRES_PASSWORD=handly_dev_pw
POSTGRES_DB=handly
DATABASE_URL="postgresql://handly:handly_dev_pw@localhost:5432/handly?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=3001
NODE_ENV=development
# Public origin of the web app, used for CORS + refresh-cookie.
WEB_ORIGIN="http://localhost:3000"

# --- Auth / JWT ---
# Generate strong values for real environments:  openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
# Column-encryption key for sensitive fields (PINFL, MyID payloads). 32 bytes base64.
FIELD_ENCRYPTION_KEY="dev-32-byte-key-change-me-please!"

# --- OTP ---
OTP_TTL_SECONDS=180
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_DAILY_CAP_PER_PHONE=10

# --- Login brute-force protection ---
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=900

# --- SMS provider: "mock" (logs code to console) | "eskiz" ---
SMS_PROVIDER=mock
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_BASE_URL="https://notify.eskiz.uz/api"
ESKIZ_FROM="4546"

# --- Tax provider: "mock" (MVP) | "soliq" (later) ---
TAX_PROVIDER=mock
TAX_WITHHOLDING_RATE=0.01

# --- AI diagnosis: "mock" (deterministic, no key needed) | "claude" ---
AI_PROVIDER=mock
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"
AI_TIMEOUT_MS=12000

# --- Order media uploads (local disk in dev; S3 provider later) ---
UPLOAD_DIR="./uploads"
UPLOAD_MAX_PHOTO_MB=10
UPLOAD_MAX_VIDEO_MB=50
ORDER_MAX_MEDIA=5

# --- Push notifications: "mock" (logs to console) | "fcm" ---
PUSH_PROVIDER=mock
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Dispatch (M3 matching) ---
DISPATCH_TOP_N=5
DISPATCH_RADIUS_EXPANSION_FACTOR=2
DISPATCH_OFFER_TTL_SCHEDULED_SECONDS=600
DISPATCH_OFFER_TTL_PRIORITY_SECONDS=120
DISPATCH_OFFER_TTL_EMERGENCY_SECONDS=60

# --- Payments (M5): "mock" only — Click/Payme/Uzum need real merchant credentials ---
PAYMENT_PROVIDER=mock

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_NAME="Handly"
